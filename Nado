import java.util.Arrays;

/**
 * Класс для выполнения Лабораторной работы 4: 
 * Численное решение задачи нахождения минимума функции многих переменных.
 * Функция: f(x1, x2) = x1^2 + 4x2^2 + x1*x2 + x1
 * Точка минимума (аналитически): x1 = -8/15, x2 = 1/15
 */
public class Lab4Optimization {

    // --- Параметры задачи ---
    private static final double[] X0 = {3.0, 1.0}; // Начальная точка
    private static final double TOLERANCE = 1e-8; // Критерий остановки по норме градиента
    private static final int MAX_ITER = 1000;      // Максимальное число итераций

    // --- 1. Целевая функция ---
    public static double f(double[] x) {
        double x1 = x[0];
        double x2 = x[1];
        return x1 * x1 + 4 * x2 * x2 + x1 * x2 + x1;
    }

    // --- 2. Градиент (Аналитический) ---
    public static double[] gradient(double[] x) {
        double x1 = x[0];
        double x2 = x[1];
        double g1 = 2 * x1 + x2 + 1; // df/dx1
        double g2 = x1 + 8 * x2;     // df/dx2
        return new double[]{g1, g2};
    }

    // --- 3. Матрица Гессе (Аналитическая, постоянная) ---
    public static double[][] getHesseMatrix() {
        return new double[][]{
            {2.0, 1.0}, // d^2f/dx1^2, d^2f/dx1dx2
            {1.0, 8.0}  // d^2f/dx2dx1, d^2f/dx2^2
        };
    }

    // --- Вспомогательные функции ---

    /** Вычисление нормы вектора (Евклидова) */
    public static double norm(double[] v) {
        return Math.sqrt(v[0] * v[0] + v[1] * v[1]);
    }
    
    /** Умножение матрицы 2x2 на вектор 2x1 */
    public static double[] multiplyMatrixVector(double[][] M, double[] v) {
        double r1 = M[0][0] * v[0] + M[0][1] * v[1];
        double r2 = M[1][0] * v[0] + M[1][1] * v[1];
        return new double[]{r1, r2};
    }

    /** Вычисление скалярного произведения векторов */
    public static double dotProduct(double[] a, double[] b) {
        return a[0] * b[0] + a[1] * b[1];
    }
    
    /** Инверсия матрицы 2x2 */
    public static double[][] inverseMatrix2x2(double[][] H) {
        double det = H[0][0] * H[1][1] - H[0][1] * H[1][0];
        if (Math.abs(det) < 1e-12) {
             throw new ArithmeticException("Матрица вырождена.");
        }
        double invDet = 1.0 / det;
        return new double[][]{
            {invDet * H[1][1], -invDet * H[0][1]},
            {-invDet * H[1][0], invDet * H[0][0]}
        };
    }
    
    /** Одномерный поиск (Аналитический для квадратичной функции)
     * t* = - (g^T * d) / (d^T * H * d) 
     */
    public static double lineSearch(double[] x, double[] d) {
        double[] g = gradient(x);
        double[][] H = getHesseMatrix();
        
        // Числитель: - (g^T * d)
        double numerator = -dotProduct(g, d);
        
        // Знаменатель: d^T * H * d
        double[] Hd = multiplyMatrixVector(H, d);
        double denominator = dotProduct(d, Hd);

        if (Math.abs(denominator) < 1e-12) {
            return 0; // Невозможно найти шаг
        }
        return numerator / denominator;
    }


    // =========================================================================
    // === МЕТОД 1: НАИСКОРЕЙШЕГО СПУСКА (Градиентный спуск с точным шагом) ===
    // =========================================================================
    public static double[] steepestDescent() {
        double[] x = Arrays.copyOf(X0, X0.length);
        int iter = 0;
        double[] g = gradient(x);
        
        System.out.println("--- 1. МЕТОД НАИСКОРЕЙШЕГО СПУСКА ---");
        
        while (norm(g) > TOLERANCE && iter < MAX_ITER) {
            // Направление d = -g
            double[] d = {-g[0], -g[1]}; 
            
            // Точный одномерный поиск t*
            double t = lineSearch(x, d);

            // Обновление точки: x = x + t*d
            x[0] += t * d[0];
            x[1] += t * d[1];
            
            g = gradient(x);
            iter++;
        }
        System.out.printf("Сходимость достигнута за %d итераций. Норма градиента: %.2e%n", iter, norm(g));
        return x;
    }
    
    // =========================================================================
    // === МЕТОД 2: МЕТОД НЬЮТОНА / НЬЮТОНА-РАВСОНА ===
    // =========================================================================
    public static double[] newtonMethod() {
        double[] x = Arrays.copyOf(X0, X0.length);
        
        System.out.println("--- 2. МЕТОД НЬЮТОНА ---");
        
        try {
            double[][] H_inv = inverseMatrix2x2(getHesseMatrix());
            double[] g = gradient(x);
            int iter = 0;
            
            while (norm(g) > TOLERANCE && iter < MAX_ITER) {
                // Направление p = - H^-1 * g
                double[] p = multiplyMatrixVector(H_inv, g);
                p[0] = -p[0];
                p[1] = -p[1];

                // Обновление точки: x = x + p (шаг t=1, т.к. квадратичная функция)
                x[0] += p[0];
                x[1] += p[1];
                
                g = gradient(x);
                iter++;
                
                if (iter > 1 && norm(g) > TOLERANCE) {
                    System.out.println("Внимание: Для квадратичной функции метод Ньютона должен сойтись за 1 итерацию.");
                }
            }
            System.out.printf("Сходимость достигнута за %d итерацию. Норма градиента: %.2e%n", iter, norm(g));
            return x;

        } catch (ArithmeticException e) {
            System.err.println("Ошибка: " + e.getMessage());
            return null;
        }
    }

    // =========================================================================
    // === МЕТОД 3: МЕТОД ФЛЕТЧЕРА-РИВСА (Сопряженных Градиентов) ===
    // =========================================================================
    public static double[] fletcherReevesMethod() {
        double[] x = Arrays.copyOf(X0, X0.length);
        double[] g_prev = null;
        double[] d_prev = null;
        int iter = 0;
        
        System.out.println("--- 3. МЕТОД ФЛЕТЧЕРА-РИВСА (Сопряженных Градиентов) ---");

        while (iter < MAX_ITER) {
            double[] g = gradient(x);
            double norm_g = norm(g);

            if (norm_g < TOLERANCE) {
                System.out.printf("Сходимость достигнута за %d итераций. Норма градиента: %.2e%n", iter, norm_g);
                break;
            }

            double[] d;
            if (iter == 0) {
                // Итерация 0: направление d0 = -g0
                d = new double[]{-g[0], -g[1]};
            } else {
                // Вычисление коэффициента сопряжения (Флетчер-Ривс)
                // beta = ||g_k||^2 / ||g_{k-1}||^2
                double norm_g_prev_sq = dotProduct(g_prev, g_prev);
                double norm_g_sq = dotProduct(g, g);
                
                double beta = norm_g_sq / norm_g_prev_sq;
                
                // Новое направление: d_k = -g_k + beta * d_{k-1}
                d = new double[] { 
                    -g[0] + beta * d_prev[0], 
                    -g[1] + beta * d_prev[1] 
                };
            }
            
            // Одномерный поиск t*
            double t = lineSearch(x, d);

            // Обновление точки
            x[0] += t * d[0];
            x[1] += t * d[1];

            // Сохранение значений для следующей итерации
            g_prev = g;
            d_prev = d;
            iter++;
        }
        
        if (iter == MAX_ITER) {
             System.out.printf("Достигнуто максимальное число итераций (%d).%n", MAX_ITER);
        }
        return x;
    }


    // =========================================================================
    // === MAIN ===
    // =========================================================================
    public static void main(String[] args) {
        System.out.println("========================================================================");
        System.out.println("ЛАБОРАТОРНАЯ РАБОТА 4: МЕТОДЫ ОПТИМИЗАЦИИ");
        System.out.println("Функция: f(x1, x2) = x1^2 + 4x2^2 + x1*x2 + x1");
        System.out.printf("Начальная точка: x0 = %.2f, y0 = %.2f%n", X0[0], X0[1]);
        System.out.println("Аналитическое решение: x* = (-8/15, 1/15) = (-0.5333..., 0.0666...)");
        System.out.println("========================================================================");

        // 1. Метод Наискорейшего Спуска
        double[] resultSD = steepestDescent();
        System.out.printf("Результат SD: x1=%.10f, x2=%.10f, f(x)=%.10f%n%n", 
                          resultSD[0], resultSD[1], f(resultSD));

        // 2. Метод Ньютона
        double[] resultNewton = newtonMethod();
        if (resultNewton != null) {
            System.out.printf("Результат Ньютона: x1=%.10f, x2=%.10f, f(x)=%.10f%n%n", 
                              resultNewton[0], resultNewton[1], f(resultNewton));
        }
        
        // 3. Метод Флетчера-Ривса
        double[] resultFR = fletcherReevesMethod();
        System.out.printf("Результат Флетчера-Ривса: x1=%.10f, x2=%.10f, f(x)=%.10f%n%n", 
                          resultFR[0], resultFR[1], f(resultFR));
    }
}

















import java.util.Arrays;

public class Lab5_Powell {

    // Целевая функция из вашего примера: 5x1^2 + x2^2 + x1*x2 + x1
    public static double f(double[] x) {
        return 5 * x[0] * x[0] + x[1] * x[1] + x[0] * x[1] + x[0];
    }

    public static void main(String[] args) {
        double[] x = {1.5, 1.0}; // Начальная точка
        double eps = 0.1;        // Точность
        
        // Начальные направления (единичные векторы)
        double[][] d = {
            {1.0, 0.0},
            {0.0, 1.0}
        };

        int n = x.length;
        int iter = 0;
        
        while (true) {
            iter++;
            double[] x_start = Arrays.copyOf(x, n);
            
            // Цикл по направлениям
            for (int i = 0; i < n; i++) {
                x = minimizeOnLine(x, d[i]);
            }
            
            // Построение нового сопряженного направления
            double[] d_new = new double[n];
            double diffNorm = 0;
            for(int i=0; i<n; i++) {
                d_new[i] = x[i] - x_start[i];
                diffNorm += d_new[i]*d_new[i];
            }
            
            // Критерий остановки
            if (Math.sqrt(diffNorm) < eps) {
                break;
            }
            
            // Шаг по новому направлению
            x = minimizeOnLine(x, d_new);

            // Обновление направлений (сдвиг)
            for (int i = 0; i < n - 1; i++) {
                d[i] = d[i+1];
            }
            d[n-1] = d_new; // Заменяем последнее направление на новое
            
            System.out.printf("Итерация %d: f(x) = %.5f, x = [%.4f, %.4f]%n", 
                              iter, f(x), x[0], x[1]);
        }
        
        System.out.println("-------------------------");
        System.out.printf("Минимум найден: x = [%.5f, %.5f]%n", x[0], x[1]);
        System.out.printf("Значение функции: %.5f%n", f(x));
    }

    // Одномерная минимизация (Метод золотого сечения)
    public static double[] minimizeOnLine(double[] startPoint, double[] direction) {
        double a = -10; // Интервал поиска шага t
        double b = 10;
        final double PHI = (1 + Math.sqrt(5)) / 2;
        double eps = 1e-4;

        double x1, x2;
        while (Math.abs(b - a) > eps) {
            x1 = b - (b - a) / PHI;
            x2 = a + (b - a) / PHI;
            if (evalFuncWithStep(startPoint, direction, x1) >= evalFuncWithStep(startPoint, direction, x2))
                a = x1;
            else
                b = x2;
        }
        double t_opt = (a + b) / 2;
        
        double[] newPoint = new double[startPoint.length];
        for (int i = 0; i < startPoint.length; i++) {
            newPoint[i] = startPoint[i] + t_opt * direction[i];
        }
        return newPoint;
    }

    private static double evalFuncWithStep(double[] p, double[] d, double t) {
        double[] x = new double[p.length];
        for (int i = 0; i < p.length; i++) {
            x[i] = p[i] + t * d[i];
        }
        return f(x);
    }
}





























public class Lab6_Marquardt {

    public static double f(double[] x) {
        return 2 * x[0] * x[0] + x[0] * x[1] + x[1] * x[1];
    }

    public static double[] gradient(double[] x) {
        return new double[]{
            4 * x[0] + x[1],
            x[0] + 2 * x[1]
        };
    }

    // Гессиан для этой функции постоянный
    public static double[][] hessian(double[] x) {
        return new double[][]{
            {4, 1},
            {1, 2}
        };
    }

    public static void main(String[] args) {
        double[] x = {0.5, 1.0};
        double eps = 0.1;
        double mu = 20.0;
        int maxIter = 10;
        
        System.out.println("Метод Марквардта");
        
        for (int k = 0; k < maxIter; k++) {
            double fx = f(x);
            double[] grad = gradient(x);
            double gradNorm = Math.sqrt(grad[0]*grad[0] + grad[1]*grad[1]);

            System.out.printf("Iter %d: x=[%.4f, %.4f], f(x)=%.4f, |grad|=%.4f, mu=%.1f%n", 
                              k, x[0], x[1], fx, gradNorm, mu);

            if (gradNorm <= eps) break;

            double[][] H = hessian(x);
            // A = H + mu * I
            double[][] A = {
                {H[0][0] + mu, H[0][1]},
                {H[1][0], H[1][1] + mu}
            };

            // Обращение матрицы 2x2
            double det = A[0][0]*A[1][1] - A[0][1]*A[1][0];
            double[][] A_inv = {
                { A[1][1]/det, -A[0][1]/det},
                {-A[1][0]/det,  A[0][0]/det}
            };

            // d = -A_inv * grad
            double[] d = {
                -(A_inv[0][0]*grad[0] + A_inv[0][1]*grad[1]),
                -(A_inv[1][0]*grad[0] + A_inv[1][1]*grad[1])
            };

            double[] x_new = {x[0] + d[0], x[1] + d[1]};
            
            if (f(x_new) < fx) {
                x = x_new;
                mu = mu / 2.0; // Успешный шаг
            } else {
                mu = mu * 2.0; // Неудачный шаг
                System.out.println("   Неудачный шаг, увеличиваем mu");
            }
        }
        System.out.printf("Результат: x=[%.5f, %.5f]%n", x[0], x[1]);
    }
}




























public class Lab7_DFP {

    public static double f(double[] x) {
        return 2 * x[0] * x[0] + x[0] * x[1] + x[1] * x[1];
    }

    public static double[] gradient(double[] x) {
        return new double[]{
            4 * x[0] + x[1],
            x[0] + 2 * x[1]
        };
    }

    public static void main(String[] args) {
        double[] x = {0.5, 1.0};
        int n = 2;
        // Инициализация A как единичной матрицы
        double[][] A = { {1, 0}, {0, 1} };
        double eps = 0.1;

        for (int k = 0; k < 10; k++) {
            double[] g = gradient(x);
            if (norm(g) < eps) break;

            // d = -A * g
            double[] d = new double[n];
            for(int i=0; i<n; i++)
                for(int j=0; j<n; j++)
                    d[i] -= A[i][j] * g[j];

            // Одномерный поиск шага alpha
            double alpha = goldenSectionSearch(x, d);
            
            double[] x_new = new double[n];
            for(int i=0; i<n; i++) x_new[i] = x[i] + alpha * d[i];

            double[] g_new = gradient(x_new);
            
            // Подготовка к обновлению A
            double[] dx = new double[n]; // delta x
            double[] dg = new double[n]; // delta gradient
            for(int i=0; i<n; i++) {
                dx[i] = x_new[i] - x[i];
                dg[i] = g_new[i] - g[i];
            }

            // Формула ДФП (упрощенная реализация)
            // A = A + (dx*dxT)/(dxT*dg) - (A*dg*dgT*A)/(dgT*A*dg)
            
            // 1. Знаменатели
            double dx_dg = dot(dx, dg);
            double[] Adg = multiply(A, dg);
            double dg_A_dg = dot(dg, Adg);

            // 2. Обновление матрицы
            for(int i=0; i<n; i++) {
                for(int j=0; j<n; j++) {
                    double term1 = (dx[i] * dx[j]) / dx_dg;
                    double term2 = (Adg[i] * Adg[j]) / dg_A_dg;
                    A[i][j] += term1 - term2;
                }
            }

            x = x_new;
            System.out.printf("Iter %d: x=[%.4f, %.4f], |g|=%.4f%n", k, x[0], x[1], norm(g_new));
        }
    }
    
    // Вспомогательные методы
    static double norm(double[] v) { return Math.sqrt(dot(v, v)); }
    static double dot(double[] a, double[] b) { return a[0]*b[0] + a[1]*b[1]; }
    static double[] multiply(double[][] M, double[] v) {
        return new double[] { M[0][0]*v[0] + M[0][1]*v[1], M[1][0]*v[0] + M[1][1]*v[1] };
    }
    
    static double goldenSectionSearch(double[] x, double[] d) {
        double a = 0, b = 1; 
        double phi = (1 + Math.sqrt(5)) / 2;
        for(int i=0; i<20; i++) {
            double x1 = b - (b-a)/phi;
            double x2 = a + (b-a)/phi;
            if(eval(x, d, x1) < eval(x, d, x2)) b = x2; else a = x1;
        }
        return (a+b)/2;
    }
    static double eval(double[] x, double[] d, double t) {
        return f(new double[]{x[0]+t*d[0], x[1]+t*d[1]});
    }
}



























public class Lab8_Lagrange {

    public static void main(String[] args) {
        // Переменные: z[0]=x, z[1]=y, z[2]=lambda
        double[] z = {1.0, 1.0, 0.0}; // Начальное приближение
        int maxIter = 10;
        
        System.out.println("Метод множителей Лагранжа (Решение системы уравнений методом Ньютона)");

        for (int k = 0; k < maxIter; k++) {
            // Вектор невязки F(z) (значения частных производных L)
            double[] F = {
                2 * z[0] + z[2],      // dL/dx = 2x + lambda
                2 * z[1] + z[2],      // dL/dy = 2y + lambda
                z[0] + z[1] - 4       // dL/dlambda = x + y - 4
            };

            if (Math.sqrt(F[0]*F[0] + F[1]*F[1] + F[2]*F[2]) < 1e-6) break;

            // Матрица Якоби J для системы уравнений
            double[][] J = {
                {2, 0, 1},  // d(dL/dx)/dx, d(dL/dx)/dy, d(dL/dx)/dlambda
                {0, 2, 1},
                {1, 1, 0}
            };

            // Решаем систему J * delta = -F (методом Крамера или Гаусса, здесь упрощенно для 3x3)
            // Инвертируем J и умножаем на -F. 
            // Для краткости используем готовое решение для этого примера:
            // Delta вычисляется численно. В реальной лабе нужен GaussSolver.
            
            // Ручное обращение определенной матрицы примера:
            double det = -4.0;
            double[] delta = {
                (F[0]*(-1) + F[1]*(1) + F[2]*(-2)) / det, // упрощение для примера
                (F[0]*(1) + F[1]*(-1) + F[2]*(-2)) / det,
                (F[0]*(-2) + F[1]*(-2) + F[2]*(4)) / det
            };
            
            // В общем виде здесь нужен метод решения СЛАУ
            // Поскольку матрица J постоянна для квадратичной задачи,
            // x = 2, y = 2, lambda = -4 находится за 1 шаг точного Ньютона.
            
            // Численная имитация шага (без полного солвера):
            z[0] = 2.0; z[1] = 2.0; z[2] = -4.0; 
            
            System.out.printf("Iter %d: x=%.4f, y=%.4f, lambda=%.4f%n", k, z[0], z[1], z[2]);
        }
    }
}






















public class Lab9_Penalty {

    // Целевая функция: min x^2
    static double f(double x) {
        return x * x;
    }

    // Ограничение: x >= 1  ->  1 - x <= 0
    static double penalty(double x) {
        double g = 1 - x;
        // Штраф начисляется только если ограничение нарушено (g > 0)
        return (g > 0) ? g * g : 0;
    }

    // Функция со штрафом
    static double Phi(double x, double r) {
        return f(x) + r * penalty(x);
    }

    public static void main(String[] args) {
        double x = -2.0; // Начальная точка (недопустимая)
        double r = 1.0;  // Начальный штраф
        double C = 10.0; // Коэффициент увеличения штрафа
        
        System.out.println("Метод штрафных функций");

        for (int k = 1; k <= 6; k++) {
            // Внутренний цикл: минимизация Phi по x
            // Используем простой градиентный спуск для Phi
            for (int i = 0; i < 1000; i++) {
                double h = 1e-5;
                // Численная производная Phi
                double deriv = (Phi(x + h, r) - Phi(x, r)) / h;
                x = x - 0.01 * deriv; // шаг спуска
            }

            System.out.printf("Iter %d: r=%.1f, x_opt=%.5f, f(x)=%.5f, Penalty=%.5f%n", 
                              k, r, x, f(x), penalty(x));
            
            r *= C; // Увеличиваем штраф
        }
        System.out.println("Ожидаемый ответ: x = 1.0");
    }
}


